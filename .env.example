# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# ── Planning Center Online (READ ONLY) ───────────────────────────────────────
# Personal Access Token. Create at:
#   https://api.planningcenteronline.com/personal_access_tokens
# IMPORTANT: the token inherits its user's PCO permissions. Create it under a
# user with full People access, or syncs will silently return partial data.
PCO_APP_ID=YOUR_PCO_APP_ID
PCO_SECRET=YOUR_PCO_SECRET

# ── MailerLite (READ ONLY — analytics source, not campaign management) ───────
# Create at https://dashboard.mailerlite.com/integrations/api
# IMPORTANT: keys are bound to the user who created them. If that user is
# removed from the account the key stops working. Use a long-lived admin user.
MAILERLITE_API_KEY=YOUR_MAILERLITE_API_KEY

# ── YouTube Data API ─────────────────────────────────────────────────────────
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# ── Resend (transactional email) ─────────────────────────────────────────────
# Password resets for KidzQuest volunteers. Create at https://resend.com/api-keys
#
# Leave BLANK locally: Payload then logs mail to the console instead of sending,
# so you can read a reset link without posting real email to real people.
#
# hif.vn must be verified in Resend before the from-address will send. An
# unverified domain fails per-message, not at startup, so it looks like the app
# is broken rather than the DNS.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@hif.vn
